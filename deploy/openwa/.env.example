# OpenWA Configuration for Nexus IT Services WhatsApp API Gateway
# Repository: https://github.com/rmyndharis/OpenWA.git

NODE_ENV=production
PORT=2785
API_PREFIX=/api

# Database Engine (sqlite for zero-config, postgres for high concurrency)
DB_TYPE=sqlite
SQLITE_DATABASE=./data/openwa.sqlite

# Storage paths
SESSIONS_DIR=./data/sessions
AUTH_DIR=./data/auth
MEDIA_DIR=./data/media

# WhatsApp Engine: 'baileys' (lightweight, recommended) or 'whatsapp-web.js' (full browser)
DEFAULT_ENGINE=baileys

# Master API Key (32+ chars in production)
API_MASTER_KEY=nexus_openwa_secure_key_2026_dxb
ALLOW_DEV_API_KEY=true

# Security and Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_PER_MINUTE=60
ENABLE_SWAGGER=true
CSP_UPGRADE_INSECURE_REQUESTS=false

# Nexus IT Services Target WhatsApp Recipient
WHATSAPP_TARGET_NUMBER=971526367221
